{
  "kind": "collectionType",
  "collectionName": "officers",
  "info": {
    "singularName": "officer",
    "pluralName": "officers",
    "displayName": "Officer",
    "description": "Leadership officers, trustees, and committee members"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "fullName": {
      "type": "string",
      "required": true
    },
    "role": {
      "type": "string",
      "required": true
    },
    "bio": {
      "type": "text"
    },
    "headshot": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "committees": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::committee.committee",
      "inversedBy": "officers"
    },
    "isOfficer": {
      "type": "boolean",
      "default": false
    },
    "isChair": {
      "type": "boolean",
      "default": false
    },
    "displayOrder": {
      "type": "integer",
      "default": 0
    }
  }
}
