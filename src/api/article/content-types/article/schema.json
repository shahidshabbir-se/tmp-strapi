{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Title": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "Slug": {
      "type": "uid",
      "targetField": "Title",
      "required": true
    },
    "Description": {
      "type": "text",
      "required": true
    },
    "Published": {
      "type": "date"
    },
    "CoverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "ContentBody": {
      "type": "dynamiczone",
      "components": [
        "article-component.quote",
        "article-component.paragraph",
        "article-component.image-with-caption"
      ]
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author",
      "inversedBy": "articles"
    },
    "topics": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::topic.topic",
      "mappedBy": "articles"
    }
  }
}
